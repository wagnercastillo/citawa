# Base de datos (docker compose)
DATABASE_URL=postgres://recep:recep@localhost:5434/recepcionista
DATABASE_URL_TEST=postgres://recep:recep@localhost:5434/recepcionista_test

# API
PORT=4000
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
THROTTLE_LIMIT=10
# Proxies de confianza para obtener la IP real (Express "trust proxy"): "loopback" en local, nº de saltos en producción
TRUST_PROXY=loopback
WEB_URL=http://localhost:3000
# Clave para cifrar API keys de WhatsApp (32 bytes base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# URL pública de la API (360dialog envía el webhook aquí). En local: la del túnel (cloudflared/ngrok)
PUBLIC_API_URL=http://localhost:4000
# "false" desactiva el cron de recordatorios
SCHEDULER_ENABLED=true
# 360dialog Partner (Integrated Onboarding). Partner ID y API key del Partner Hub (sección API Keys)
D360_PARTNER_ID=
D360_PARTNER_API_KEY=

# Superadmin inicial (npm run seed:superadmin -w apps/api)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=cambia-esta-clave

# Web (Next.js lee API_URL en apps/web; por defecto http://localhost:4000)
API_URL=http://localhost:4000
